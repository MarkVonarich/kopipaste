# Telegram
BOT_TOKEN=

# Database
DATABASE_URL=

# Runtime
ENVIRONMENT=
LOG_LEVEL=

# Optional integrations
REDIS_URL=
SENTRY_DSN=

# Optional: receipt OCR provider key (if empty, image import works in graceful fallback mode)
RECEIPT_OCR_API_KEY=
RECEIPT_OCR_PROVIDER=openai
RECEIPT_OCR_MODEL=gpt-4.1-mini

# Voice input
VOICE_INPUT_ENABLED=true
VOICE_TRANSCRIBE_PROVIDER=openai
VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VOICE_MAX_SECONDS=60
